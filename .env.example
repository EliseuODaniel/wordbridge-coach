# WordBridge Coach local environment template.
#
# Copy to .env for local overrides. Do not commit .env files or real secrets.

# API runtime safety
ENVIRONMENT=development
DEBUG=true
STRICT_CONFIG=false
SECRET_KEY=wordbridge-local-dev-secret-not-for-production

# Local service ports exposed on the host
WORDBRIDGE_DB_PORT=5432
WORDBRIDGE_TEST_DB_PORT=5433
WORDBRIDGE_API_PORT=8000
WORDBRIDGE_FRONTEND_PORT=3007
WORDBRIDGE_TTS_PORT=8001
WORDBRIDGE_LLM_PORT=8080
WORDBRIDGE_LLM_CHAT_PORT=8081
WORDBRIDGE_LLM_TEACHER_PORT=8082
# Use an absolute host path when model files live outside this repository.
# Symlinks pointing outside a bind mount are not visible inside the container.
WORDBRIDGE_MODELS_PATH=./llm_models
WORDBRIDGE_LANGUAGETOOL_PORT=8010
WORDBRIDGE_DOCKER_SUBNET=172.20.0.0/16

# Optional API/runtime toggles
INSTALL_ARGOS=false
LINGVIST_TRANSLATIONS_AUTOFILL=true
LINGVIST_TRANSLATIONS_PROVIDER=google_http
LINGVIST_TRANSLATIONS_NETWORK_ENABLED=true
LINGVIST_TRANSLATIONS_TARGET_LANG=pt

# Optional Vite dev proxy overrides
WORDBRIDGE_API_PROXY_TARGET=http://localhost:8000
WORDBRIDGE_TTS_PROXY_TARGET=http://localhost:8001

# Chat Coach uses the mock provider in the default db/api/frontend stack.
# Set CHAT_LLM_PROVIDER=llamacpp together with the ai profile for real local LLM.
CHAT_LLM_PROVIDER=mock
CHAT_LLM_BASE_URL=http://llm:8080/v1
CHAT_LLM_MODEL=qwen3.5-9b
CHAT_LLM_STRICT=false
CHAT_DRAFT_GRAMMAR_PROVIDER=languagetool
CHAT_LANGUAGETOOL_URL=http://languagetool:8010
