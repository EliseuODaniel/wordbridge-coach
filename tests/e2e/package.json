{
  "name": "wordbridge-coach-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for WordBridge Coach using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:ci": "playwright test --config=playwright.ci.config.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "install-browsers": "playwright install",
    "report": "playwright show-report",
    "clean": "rm -rf test-results/ playwright-report/"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.0"
  }
}
